#include <bits/stdc++.h>
using namespace std;

int islandPerimeter(vector<vector<int>>& grid) {
    int n = grid.size(), m = grid[0].size();
    int per = 0;

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < m; j++) {
            if (grid[i][j] == 1) {
                // up
                if (i == 0 || grid[i-1][j] == 0) per++;
                // down
                if (i == n-1 || grid[i+1][j] == 0) per++;
                // left
                if (j == 0 || grid[i][j-1] == 0) per++;
                // right
                if (j == m-1 || grid[i][j+1] == 0) per++;
            }
        }
    }
    return per;
}





























