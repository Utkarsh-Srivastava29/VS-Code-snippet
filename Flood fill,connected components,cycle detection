#include <bits/stdc++.h>
using namespace std;

void eraseIsland(vector<vector<char>>& grid, int r, int c) {
    int n = grid.size(), m = grid[0].size();

    if (r < 0 || c < 0 || r >= n || c >= m)
        return;

    if (grid[r][c] == '0')
        return;

    grid[r][c] = '0';  // sink the land

    eraseIsland(grid, r + 1, c);
    eraseIsland(grid, r - 1, c);
    eraseIsland(grid, r, c + 1);
    eraseIsland(grid, r, c - 1);
}

int numIslands(vector<vector<char>>& grid) {
    int n = grid.size(), m = grid[0].size();
    int count = 0;

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < m; j++) {
            if (grid[i][j] == '1') {
                count++;
                eraseIsland(grid, i, j);
            }
        }
    }
    return count;
}


























