//State 0 means you have not touched this node yet 
//State 1 means you are currently proceesing this node or its neighbours,it is in the recursion stack
//State 2 means you are completely done with node and all it descendants
DFS me 3 states use hote hain—0 unvisited, 1 visiting (recursion stack), 2 visited—and agar kisi node se state-1 neighbor mile to cycle detect ho jata hai.




















#include <bits/stdc++.h>
using namespace std;

bool dfs(int u, vector<vector<int>>& g, vector<int>& vis) {
    vis[u] = 1;  // mark as visiting
    for (int v : g[u]) {
        if (vis[v] == 1) return true;        // cycle found
        “Jab tak koi branch true return nahi karti, hum us state se return nahi karte;
        aur agar koi branch true nahi deti, to end me false return karte hain.”
        if (vis[v] == 0 && dfs(v, g, vis)) 
            return true;
    }
    vis[u] = 2;  // mark as finished
    return false;
}

bool hasCycle(int n, vector<vector<int>>& edges) {
    vector<vector<int>> g(n);
    for (auto &e : edges)
        g[e[0]].push_back(e[1]);  // directed edge

    vector<int> vis(n, 0);
    for (int i = 0; i < n; i++) {
        if (vis[i] == 0 && dfs(i, g, vis))
            return true;
    }
    return false;
}



























