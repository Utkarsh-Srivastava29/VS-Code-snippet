Question-------------------------------------------------------Search for the shortest Hamiltonian walk--------------------------------------------------
#include<bits/stdc++.h>
using namespace std;

const int INF = 1e9; // large value to represent infinity

int main(){
    ios::sync_with_stdio(false);
    cin.tie(NULL);

    int n;
    cin>>n; // number of vertices

    vector<vector<int>> d(n, vector<int>(n));
    for(int i=0;i<n;i++){
        for(int j=0;j<n;j++){
            cin>>d[i][j]; // weight from i to j
        }
    }

    int N = 1<<n; // total number of masks = 2^n

    vector<vector<int>> dp(N, vector<int>(n, INF)); 
    // dp[mask][i] = minimum cost to visit nodes in mask and end at i

    vector<vector<int>> parent(N, vector<int>(n, -1)); 
    // parent[mask][i] = previous node before reaching i

    for(int i=0;i<n;i++){
        dp[1<<i][i] = 0; 
        // base case: only node i is visited, cost = 0
    }

    for(int mask=0; mask<N; mask++){ // iterate over all subsets
        for(int i=0;i<n;i++){ // try ending node i
            if(!(mask & (1<<i))) continue; 
            // if i is not in mask, skip

            int prev = mask ^ (1<<i); 
            // remove i from mask to get previous state

            if(prev == 0) continue; 
            // if no nodes left, skip (base case already handled)

            for(int j=0;j<n;j++){ // try previous node j
                if(prev & (1<<j)){ 
                    // if j is in previous mask

                    int val = dp[prev][j] + d[j][i]; 
                    // cost = previous cost + edge j→i

                    if(val < dp[mask][i]){ 
                        // if better cost found
                        dp[mask][i] = val; 
                        parent[mask][i] = j; 
                        // store j as parent of i
                    }
                }
            }
        }
    }

    int full = N-1; // mask with all nodes visited
    int best = INF, last = -1;

    for(int i=0;i<n;i++){ 
        // try all possible ending nodes
        if(dp[full][i] < best){
            best = dp[full][i]; 
            last = i; 
            // store best ending node
        }
    }

    cout<<"Minimum Cost: "<<best<<"\n";

    vector<int> path;
    int mask = full;
    int cur = last;

    while(cur != -1){ 
        // reconstruct path using parent
        path.push_back(cur); 
        // add current node

        int p = parent[mask][cur]; 
        // get previous node

        mask ^= (1<<cur); 
        // remove current node from mask

        cur = p; 
        // move to previous node
    }

    reverse(path.begin(), path.end()); 
    // reverse to get correct order

    cout<<"Path: ";
    for(auto x:path) cout<<x<<" "; 
    // print path
    cout<<"\n";
}

















Question------------------------------------------------------- Finding the number of Hamiltonian walks--------------------------------------------------
Yahan DP ka meaning hai: dp[mask][i] = kitne tarikon se hum mask wale nodes visit kar sakte hain aur last node i ho. 
Jab hum i pe end karte hain, to usse pehle kisi j se aaye honge, isliye hum dp[mask][i] += dp[mask without i][j] karte hain. 
Difference bas itna hai ki pehle wale problem me hum min le rahe the (cost minimize), aur yahan hum sum kar rahe hain (ways count karne ke liye).



#include<bits/stdc++.h>
using namespace std;

int main(){
    ios::sync_with_stdio(false);
    cin.tie(NULL);

    int n;
    cin>>n; // number of vertices

    vector<vector<int>> adj(n, vector<int>(n));
    for(int i=0;i<n;i++){
        for(int j=0;j<n;j++){
            cin>>adj[i][j]; 
            // adj[i][j] = 1 if edge exists, else 0
        }
    }

    int N = 1<<n; // total number of subsets

    vector<vector<long long>> dp(N, vector<long long>(n, 0));
    // dp[mask][i] = number of ways to visit mask and end at i

    for(int i=0;i<n;i++){
        dp[1<<i][i] = 1; 
        // base case: only node i is visited → 1 way
    }

    for(int mask=0; mask<N; mask++){ // iterate over all subsets
        for(int i=0;i<n;i++){ // try ending node i
            if(!(mask & (1<<i))) continue; 
            // if i is not in mask, skip

            int prev = mask ^ (1<<i); 
            // remove i from mask → previous state

            if(prev == 0) continue; 
            // base case already handled

            for(int j=0;j<n;j++){ // try previous node j
                if((prev & (1<<j)) && adj[j][i]){ 
                    // j must be in previous mask AND edge j→i must exist

                    dp[mask][i] += dp[prev][j]; 
                    // add number of ways to reach j
                }
            }
        }
    }

    int full = N-1; // mask with all nodes visited
    long long ans = 0;

    for(int i=0;i<n;i++){ 
        ans += dp[full][i]; 
        // sum over all possible ending nodes
    }

    cout<<ans<<"\n"; // total number of Hamiltonian paths
}




















Question-------------------------------------------------------Finding the number of simple paths--------------------------------------------------
ek khaas baat agr vertices repeat nahin ho rhi hain then hamari edges bhi repeat nahin ho skti hain and this is very important to understand


Questions:---
Tumhe total number of simple paths nikalne hain graph me
Simple path = koi vertex repeat nahi,length ≥ 1 (at least 2 nodes)


Now the solution is as follows and that is like the following:---
dp[mask][i]
kitne tarikon se hum mask ke nodes visit karke i pe end kar sakte hain
Har dp[mask][i] actually ek path represent karta hai



Ab simple paths kaise milenge?:---
Har possible path ka koi na koi:
mask hoga
ending node hoga
isliye agar tum sab dp values add kar do:Σ dp[mask][i]


Lekin ek condition hai:---
count(mask) ≥ 2
mask size = 1 → sirf ek node → path length = 0
length ≥ 1 paths chahiye



Sabse IMPORTANT: divide by 2:---
answer = (1/2) * Σ dp[mask][i]
kyunki har path 2 baar count ho raha hai
1 → 2 → 3
3 → 2 → 1
These are same in the undirected graphs but in case of undirected graphs these paths are the same and simple so no need to care about the above
final answer = total / 2
If we have to count for path lengths zero also then we will also add n to tha answer
answer = 1/2 * Σ dp[mask][i]  (where count(mask) ≥ 2)




