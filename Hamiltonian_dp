#include<bits/stdc++.h>
using namespace std;

int main(){
    ios::sync_with_stdio(false);
    cin.tie(NULL);

    int n;
    cin>>n;

    vector<vector<int>> adj(n, vector<int>(n));
    for(int i=0;i<n;i++){
        for(int j=0;j<n;j++){
            cin>>adj[i][j]; // 1 if edge exists
        }
    }

    int N = 1<<n;

    vector<vector<long long>> dp(N, vector<long long>(n, 0));
    // dp[mask][i] = number of ways to visit mask and end at i

    for(int i=0;i<n;i++){
        dp[1<<i][i] = 1; // base case
    }

    for(int mask=0; mask<N; mask++){
        for(int i=0;i<n;i++){
            if(!(mask & (1<<i))) continue;

            int prev = mask ^ (1<<i);
            if(prev == 0) continue;

            for(int j=0;j<n;j++){
                if((prev & (1<<j)) && adj[j][i]){
                    dp[mask][i] += dp[prev][j];
                }
            }
        }
    }

    long long total = 0;

    for(int mask=0; mask<N; mask++){
        if(__builtin_popcount(mask) < 2) continue; // only length ≥ 1 paths

        for(int i=0;i<n;i++){
            if(mask & (1<<i)){
                total += dp[mask][i];
            }
        }
    }

    cout << total/2 << "\n"; // divide by 2 (double counting)
}














Question-------------------------------------------------------kya Hamiltonian walk exist karta hai ya nahi?--------------------------------------------------
kya koi path hai jo saare nodes exactly 1 baar visit kare
Same DP use karte hain:
dp[mask][i]-->kya koi path exist karta hai jo mask visit kare aur i pe end kare?
1 → exist karta hai
0 → exist nahi karta




Transition (sum → OR):---
Pehle hum count kar rahe the:
dp += ...
Ab sirf existence check karna hai:
dp |= ...





dp[mask][i] = OR over j:
dp[mask without i][j]
agar koi bhi valid j mil gaya → answer true



Base case:---
dp[1<<i][i] = 1



Final answer:---
check dp[(1<<n)-1][i] for any i
agar kisi bhi i ke liye true → Hamiltonian path exists



This solution uses O(2n) of memory and O(2nn) of time.




#include<bits/stdc++.h>
using namespace std;

int main(){
    ios::sync_with_stdio(false);
    cin.tie(NULL);

    int n;
    cin>>n;

    vector<int> M(n, 0); // adjacency mask

    for(int i=0;i<n;i++){
        for(int j=0;j<n;j++){
            int x;
            cin>>x;
            if(x) M[i] |= (1<<j); // j is neighbor of i
        }
    }

    int N = 1<<n;
    vector<int> dp(N, 0); // dp'[mask]

    for(int i=0;i<n;i++){
        dp[1<<i] = (1<<i); // only i is possible ending node
    }

    for(int mask=1; mask<N; mask++){
        for(int i=0;i<n;i++){
            if(!(mask & (1<<i))) continue;

            int prev = mask ^ (1<<i);
            if(prev == 0) continue;

            if(dp[prev] & M[i]){
                dp[mask] |= (1<<i); // i is valid ending node
            }
        }
    }

    if(dp[N-1] != 0) cout<<"YES\n";
    else cout<<"NO\n";
}
















Question-------------------------------------------------------Finding the shortest Hamiltonian cycle--------------------------------------------------
#include<bits/stdc++.h>
using namespace std;

const int INF = 1e9; // large value to represent infinity

int main(){
    ios::sync_with_stdio(false);
    cin.tie(NULL);

    int n;
    cin>>n; // number of vertices

    vector<vector<int>> d(n, vector<int>(n));
    for(int i=0;i<n;i++){
        for(int j=0;j<n;j++){
            cin>>d[i][j]; 
            // d[i][j] = cost from node i to node j
        }
    }

    int N = 1<<n; 
    // total number of subsets (2^n)

    vector<vector<int>> dp(N, vector<int>(n, INF));
    /*
    dp[mask][i] = minimum cost to:
    - start from node 0
    - visit all nodes in 'mask'
    - end at node i
    */

    dp[1][0] = 0; 
    // base case:
    // mask = 000...001 → only node 0 is visited
    // cost = 0 (starting point)

    for(int mask=1; mask<N; mask++){ 
        // iterate over all subsets

        if(!(mask & 1)) continue; 
        // ensure node 0 is always included in mask
        // because we always start from node 0

        for(int i=0;i<n;i++){ 
            // try ending node i

            if(!(mask & (1<<i))) continue; 
            // if i is not in mask, skip

            if(i==0 && mask!=1) continue; 
            // we cannot come back to node 0 in between
            // node 0 should only be at the start

            int prev = mask ^ (1<<i); 
            // remove i from mask → previous state

            for(int j=0;j<n;j++){ 
                // try previous node j

                if(prev & (1<<j)){ 
                    // if j is present in previous mask

                    dp[mask][i] = min(dp[mask][i],
                                      dp[prev][j] + d[j][i]);
                    /*
                    transition:
                    - we reached j earlier
                    - now go from j → i
                    - update minimum cost
                    */
                }
            }
        }
    }

    int full = N-1; 
    // mask with all nodes visited (111...111)

    int ans = INF;

    for(int i=1;i<n;i++){ 
        // try all possible ending nodes except 0

        ans = min(ans, dp[full][i] + d[i][0]);
        /*
        complete the cycle:
        - path ends at i
        - go back to 0
        */
    }

    cout<<ans<<"\n"; 
    // minimum cost Hamiltonian cycle
}













Question-------------------------------------------------------Finding the number of Hamiltonian cycles--------------------------------------------------
#include<bits/stdc++.h>
using namespace std;

int main(){
    ios::sync_with_stdio(false);
    cin.tie(NULL);

    int n;
    cin>>n; 
    // number of vertices

    vector<vector<int>> adj(n, vector<int>(n));
    for(int i=0;i<n;i++){
        for(int j=0;j<n;j++){
            cin>>adj[i][j]; 
            // adj[i][j] = 1 means edge exists from i to j
        }
    }

    int N = 1<<n; 
    // total number of subsets of vertices (2^n)

    vector<vector<long long>> dp(N, vector<long long>(n, 0));
    /*
    dp[mask][i] = number of ways to:
    - start from node 0
    - visit exactly the set of nodes in 'mask'
    - end at node i

    NOTE:
    - mask represents visited nodes
    - i must be present in mask
    */

    dp[1][0] = 1; 
    // base case:
    // mask = 000...001 → only node 0 visited
    // exactly 1 way: start and stay at node 0

    for(int mask=1; mask<N; mask++){

        if(!(mask & 1)) continue; 
        // enforce that node 0 is always included
        // since all paths start from node 0

        for(int i=0;i<n;i++){

            if(!(mask & (1<<i))) continue; 
            // i must be part of the current subset

            if(i==0 && mask!=1) continue; 
            // do NOT return to node 0 before visiting all nodes
            // 0 is only allowed as the starting point

            int prev = mask ^ (1<<i); 
            // remove i from mask → previous state
            // represents path before reaching i

            for(int j=0;j<n;j++){

                if((prev & (1<<j)) && adj[j][i]){
                    // j must be in prev mask
                    // and there must be an edge from j → i

                    dp[mask][i] += dp[prev][j];
                    /*
                    extend all valid paths ending at j
                    by adding edge j → i

                    so total ways accumulate
                    */
                }
            }
        }
    }

    int full = N-1; 
    // mask with all nodes visited

    long long ans = 0;

    for(int i=1;i<n;i++){

        if(adj[i][0]){ 
            // if we can go from i → 0

            ans += dp[full][i];
            /*
            complete the cycle:
            0 → ... → i → 0

            add all paths that end at i
            */
        }
    }

    cout<<ans<<"\n"; 
    // total number of Hamiltonian cycles starting at 0
}















Question-------------------------------------------------------Finding the number of simple cycles--------------------------------------------------
//ye keval unhein cycles ko count krta hai jo kahein se start first(mask) hamne ix kr diya ki kahein se start hone waali cycles ho rhi hai and then all the elements belong to that cycle and does not include repetaed or incomplete cycles
This solution requres O(2^n*n2) of time and O(2^n*n) of memory.
#include<bits/stdc++.h>
using namespace std;

int main(){
    ios::sync_with_stdio(false);
    cin.tie(NULL);

    int n;
    cin>>n; 
    // number of vertices

    vector<vector<int>> adj(n, vector<int>(n));
    for(int i=0;i<n;i++){
        for(int j=0;j<n;j++){
            cin>>adj[i][j]; 
            // adjacency matrix:
            // adj[i][j] = 1 means edge exists from i to j
        }
    }

    int N = 1<<n; 
    // total number of subsets (2^n)

    vector<vector<long long>> dp(N, vector<long long>(n, 0));
    /*
    dp[mask][i] = number of ways to:
    - start from first(mask) (smallest node in mask)
    - visit all nodes in mask exactly once
    - end at node i
    */

    for(int mask=1; mask<N; mask++){

        int first = __builtin_ctz(mask); 
        // first(mask) = index of lowest set bit
        // this node will act as fixed starting node for this mask

        dp[1<<first][first] = 1;
        // base case:
        // only one node (first), one trivial path

        for(int i=0;i<n;i++){

            if(!(mask & (1<<i))) continue;
            // i must be part of mask

            if(i == first) continue;
            // we never return to starting node in middle
            // start node is only used at beginning

            int prev = mask ^ (1<<i);
            // remove i from mask → previous state

            for(int j=0;j<n;j++){

                if((prev & (1<<j)) && adj[j][i]){
                    // j must be in previous mask
                    // and edge j → i must exist

                    dp[mask][i] += dp[prev][j];
                    /*
                    extend all paths that ended at j
                    by adding edge j → i

                    accumulate number of ways
                    */
                }
            }
        }
    }

    long long ans = 0;

    for(int mask=1; mask<N; mask++){

        int first = __builtin_ctz(mask);
        // fixed starting node for this subset

        if(__builtin_popcount(mask) < 3) continue;
        // cycle must have at least 3 nodes

        for(int i=0;i<n;i++){

            if(i == first) continue;
            // cannot end at starting node before closing cycle

            if(mask & (1<<i)){
                // i must be in mask

                if(adj[i][first]){
                   //yahan dekhein to 1-2-3-1 ek bhi ek ho skta hai and then 1-3-2-1 bhi ek ho skta hai

                    // if edge exists from i → first
                    // then we can close the cycle

                    ans += dp[mask][i];
                    /*
                    we formed a cycle:
                    first → ... → i → first
                    */
                }
            }
        }
    }

    cout<<ans/2<<"\n";
    /*
    divide by 2 because:
    each cycle is counted twice:
    clockwise and anticlockwise
    like 1->2->3->1
    like 1->3->2->1
    */
}
















Question-------------------------------------------------------Checking for existence of Hamiltonian cycle--------------------------------------------------

#include<bits/stdc++.h>
using namespace std;

int main(){
    ios::sync_with_stdio(false);
    cin.tie(NULL);

    int n;
    cin>>n; 
    // number of vertices

    vector<int> M(n, 0); 
    // M[i] = bitmask of neighbors of node i
    // if j is neighbor of i → j-th bit of M[i] = 1

    for(int i=0;i<n;i++){
        for(int j=0;j<n;j++){
            int x;
            cin>>x; 
            // adjacency matrix input

            if(x) M[i] |= (1<<j);
            // if edge i → j exists, set j-th bit in M[i]
        }
    }

    int N = 1<<n; 
    // total number of subsets (2^n)

    vector<int> dp(N, 0);
    /*
    dp[mask] = bitmask of nodes where:
    - there exists a Hamiltonian path over 'mask'
    - ending at those nodes

    i.e. if dp[mask] has i-th bit ON,
    then there is a path visiting all nodes in mask and ending at i
    */

    for(int i=0;i<n;i++){
        dp[1<<i] = (1<<i);
        // base case:
        // single node mask → path exists ending at itself
    }

    for(int mask=1; mask<N; mask++){
        // iterate over all subsets

        for(int i=0;i<n;i++){

            if(!(mask & (1<<i))) continue;
            // i must be present in mask

            int prev = mask ^ (1<<i);
            // remove i from mask → previous subset

            if(prev == 0) continue;
            // skip single node case (already initialized)

            if(dp[prev] & M[i]){
                /*
                check:
                - dp[prev] = possible ending nodes j
                - M[i] = neighbors of i

                dp[prev] & M[i] != 0 means:
                there exists some node j such that:
                - j was an ending node in prev
                - j → i edge exists

                ⇒ we can extend path to i
                */

                dp[mask] |= (1<<i);
                // mark i as a valid ending node for mask
            }
        }
    }

    int full = N-1;
    // mask with all nodes visited

    int start = 0;
    // we fix starting node as 0

    bool exists = false;

    for(int i=0;i<n;i++){

        if(i != start){
            // avoid trivial self-loop

            if((dp[full] & (1<<i)) && (M[i] & (1<<start))){
                /*
                check two conditions:

                1. dp[full] & (1<<i)
                   → there exists a Hamiltonian path
                     visiting all nodes and ending at i

                2. M[i] & (1<<start)
                   → there is an edge from i → start

                ⇒ path can be closed into a cycle
                */

                exists = true;
            }
        }
    }

    cout<<(exists ? "YES" : "NO")<<"\n";
    // print whether Hamiltonian cycle exists
}
