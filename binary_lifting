    }

    return 0;
}








Instead of storing full log n ancestors for every node, store ancestors only up to the node’s depth to reduce memory usage in shallow trees.When n=1e6 then the time complexity might be very large
This is 2*1e7

#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(NULL);

    int n;
    cin >> n;

    vector<int> parent(n+1);
    parent[1] = -1; // root

    for(int i = 2; i <= n; i++)
        cin >> parent[i];

    // Build adjacency list
    vector<vector<int>> adj(n+1);
    for(int i = 2; i <= n; i++) {
        adj[parent[i]].push_back(i);
    }

    // Compute depth
    vector<int> depth(n+1, 0);

    function<void(int)> dfs = [&](int v) {
        for(auto u : adj[v]) {
            depth[u] = depth[v] + 1;
            dfs(u);
        }
    };

    dfs(1);

    // Optimized up table
    vector<vector<int>> up(n+1);

    // Allocate only needed columns per node
    for(int i = 1; i <= n; i++) {
        int maxJump = 0;
        while((1 << maxJump) <= depth[i])
            maxJump++;
        up[i].resize(maxJump, -1);
    }

    // Fill first column (parent)
    for(int i = 1; i <= n; i++) {
        if(!up[i].empty())
            up[i][0] = parent[i];
    }

    // Build higher columns
    int maxLog = 0;
    for(int i = 1; i <= n; i++)
        maxLog = max(maxLog, (int)up[i].size());

    for(int j = 1; j < maxLog; j++) {
        for(int i = 1; i <= n; i++) {
            if(j < up[i].size()) {
                int mid = up[i][j-1];
                if(mid != -1 && j-1 < up[mid].size())
                    up[i][j] = up[mid][j-1];
                else
                    up[i][j] = -1;
            }
        }
    }

    // Queries
    int q;
    cin >> q;

    while(q--) {
        int node;
        long long k;
        cin >> node >> k;

        for(int j = 0; j < up[node].size(); j++) {
            if(k & (1LL << j)) {
                if(j < up[node].size())
                    node = up[node][j];
                else {
                    node = -1;
                }
                if(node == -1)
                    break;
            }
        }

        cout << node << "\n";
    }

    return 0;
}



















