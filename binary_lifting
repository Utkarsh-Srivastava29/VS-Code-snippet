#include<bits/stdc++.h>
using namespace std;

const int MAXN = 200005;
const int LOG = 20;

vector<int> adj[MAXN];
int up[MAXN][LOG];
int depth[MAXN];

void dfs(int v, int p) {
    up[v][0] = p;   // 2^0 = 1 step (parent)

    for(int k = 1; k < LOG; k++) {
        if(up[v][k-1] != -1)
            up[v][k] = up[ up[v][k-1] ][k-1];
        else
            up[v][k] = -1;
    }

    for(int u : adj[v]) {
        if(u == p) continue;
        depth[u] = depth[v] + 1;
        dfs(u, v);
    }
}

// find k-th ancestor
int kthAncestor(int v, int k) {
    for(int i = 0; i < LOG; i++) {
        if(k & (1 << i)) {
            v = up[v][i];
            if(v == -1) return -1;
        }
    }
    return v;
}








