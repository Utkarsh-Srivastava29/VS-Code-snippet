20.O(V+E)
#include <bits/stdc++.h>
using namespace std;
#define int long long

vector<vector<int>> g, rg, dag;
vector<int> vis, comp, coins, compCoins, indeg;
stack<int> st;

void dfs1(int v){
    vis[v]=1;
    for(int u:g[v]){
        if(!vis[u]) dfs1(u);
    }
    st.push(v);
}

void dfs2(int v,int c){
    comp[v]=c;
    compCoins[c]+=coins[v];
    for(int u:rg[v]){
        if(comp[u]==-1) dfs2(u,c);
    }
}

int32_t main(){
    ios::sync_with_stdio(false);
    cin.tie(NULL);

    int n,m;
    cin>>n>>m;

    g.assign(n,{});
    rg.assign(n,{});
    coins.assign(n,0);

    for(int i=0;i<n;i++) cin>>coins[i];

    for(int i=0;i<m;i++){
        int u,v;
        cin>>u>>v;
        u--; v--;
        g[u].push_back(v);
        rg[v].push_back(u);
    }

    vis.assign(n,0);
    for(int i=0;i<n;i++){
        if(!vis[i]) dfs1(i);
    }

    comp.assign(n,-1);
    compCoins.assign(n,0);
    int scc=0;

    while(!st.empty()){
        int v=st.top(); st.pop();
        if(comp[v]==-1){
            dfs2(v,scc);
            scc++;
        }
    }

    dag.assign(scc,{});
    indeg.assign(scc,0);

    for(int u=0;u<n;u++){
        for(int v:g[u]){
            if(comp[u]!=comp[v]){
                dag[comp[u]].push_back(comp[v]);
                indeg[comp[v]]++;
            }
        }
    }

    vector<int> dp(scc,0);
    queue<int> q;

    for(int i=0;i<scc;i++){
        dp[i]=compCoins[i];
        if(indeg[i]==0) q.push(i);
    }

    while(!q.empty()){
        int v=q.front(); q.pop();
        for(int u:dag[v]){
            dp[u]=max(dp[u], dp[v]+compCoins[u]);
            indeg[u]--;
            if(indeg[u]==0) q.push(u);
        }
    }

    cout<<*max_element(dp.begin(), dp.end())<<"\n";
}










