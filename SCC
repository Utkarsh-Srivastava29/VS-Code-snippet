#include <bits/stdc++.h>
using namespace std;

vector<vector<int>> g;
vector<int> disc, low, on, scc;
stack<int> st;
int timer=0, comp=0;

void tarjan(int v){
    disc[v]=low[v]=timer++;
    st.push(v);
    on[v]=1;

    for(int u:g[v]){
        if(disc[u]==-1){
            tarjan(u);
            low[v]=min(low[v], low[u]);
        }else if(on[u]){
            low[v]=min(low[v], disc[u]);
        }
    }

    if(low[v]==disc[v]){
        while(st.top()!=v){
            scc[st.top()]=comp;
            on[st.top()]=0;
            st.pop();
        }
        scc[v]=comp;
        on[v]=0;
        st.pop();
        comp++;
    }
}

int main(){
    ios::sync_with_stdio(false);
    cin.tie(NULL);

    int n,m;
    cin>>n>>m;

    g.assign(n, {});
    disc.assign(n, -1);
    low.assign(n, 0);
    on.assign(n, 0);
    scc.assign(n, -1);

    for(int i=0;i<m;i++){
        int u,v;
        cin>>u>>v;
        u--; v--;
        g[u].push_back(v);
    }

    for(int i=0;i<n;i++){
        if(disc[i]==-1) tarjan(i);
    }

    cout<<comp<<"\n";
    for(int i=0;i<n;i++) cout<<scc[i]<<" ";
    cout<<"\n";
}
}









