1.SCCs compress a messy cyclic directed graph into a clean DAG, making hard graph problems easy.
2.An SCC is the largest group of nodes in a directed graph where every node can reach every other node.
3.Jab directed graph messy lage, SCC nikalo — graph turant tame ho jaata hai. Package managers use SCCs to detect circular dependencies. Build systems use them to find compilation order.Search engines use them to identify strongly connected web communities.
4.Search engines SCCs ka use karke web pages ke tightly-linked groups (communities) ko identify karte hain jo ek hi topic ya ecosystem se belong karte hain.
5.Kosaraju uses two DFS—first to order nodes by finish time, second on the reversed graph to extract each SCC one by one.
6.Kosaraju = DFS to push nodes by finish time, reverse edges, then DFS in stack order—each DFS gives one SCC.







7.O(V+E)
#include <bits/stdc++.h>
using namespace std;

vector<vector<int>> g, rg;
vector<int> vis, comp;
stack<int> st;

void dfs1(int v){
    vis[v]=1;
    for(int u:g[v]){
        if(!vis[u]) dfs1(u);
    }
    st.push(v);
}

void dfs2(int v,int c){
    comp[v]=c;
    for(int u:rg[v]){
        if(comp[u]==-1) dfs2(u,c);
    }
}

int main(){
    ios::sync_with_stdio(false);
    cin.tie(NULL);

    int n,m;
    cin>>n>>m;

    g.assign(n, {});
    rg.assign(n, {});
    vis.assign(n, 0);
    comp.assign(n, -1);

    for(int i=0;i<m;i++){
        int u,v;
        cin>>u>>v;
        u--; v--;
        g[u].push_back(v);
        rg[v].push_back(u);
    }

    for(int i=0;i<n;i++){
        if(!vis[i]) dfs1(i);
    }

    int c=0;
    while(!st.empty()){
        int v=st.top();
        st.pop();
        if(comp[v]==-1){
            dfs2(v,c);
            c++;
        }
    }

    cout<<c<<"\n";
    for(int i=0;i<n;i++) cout<<comp[i]<<" ";
    cout<<"\n";
}








