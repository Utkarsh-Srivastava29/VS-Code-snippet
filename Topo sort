#include <bits/stdc++.h>
using namespace std;

vector<vector<int>> adj;
vector<int> color, parent;
vector<int> cycle;
int start_node = -1, end_node = -1;

bool dfs(int u) {
    color[u] = 1; // gray

    for (int v : adj[u]) {
        if (color[v] == 0) {
            parent[v] = u;
            if (dfs(v)) return true;
        }
        else if (color[v] == 1) {
            // cycle found
            start_node = v;
            end_node = u;
            return true;
        }
    }

    color[u] = 2; // black
    return false;
}

int main() {
    int n, m;
    cin >> n >> m;

    adj.assign(n, {});
    color.assign(n, 0);
    parent.assign(n, -1);

    for (int i = 0; i < m; i++) {
        int u, v;
        cin >> u >> v;
        adj[u].push_back(v);
    }

    for (int i = 0; i < n; i++) {
        if (color[i] == 0) {
            if (dfs(i)) break;
        }
    }

    if (start_node == -1) {
        cout << "No cycle\n";
    } else {
        // reconstruct cycle
        vector<int> path;
        path.push_back(start_node);

        for (int v = end_node; v != start_node; v = parent[v])
            path.push_back(v);

        path.push_back(start_node);
        reverse(path.begin(), path.end());

        cout << "Cycle: ";
        for (int x : path)
            cout << x << " ";
        cout << "\n";
    }
}



















