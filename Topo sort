#include <bits/stdc++.h>
using namespace std;

int minimumTime(int n, vector<vector<int>>& relations, vector<int>& time) {
    vector<vector<int>> adj(n);
    vector<int> indegree(n, 0);

    // Build graph
    for (auto& r : relations) {
        int u = r[0] - 1;  // 0-based
        int v = r[1] - 1;
        adj[u].push_back(v);
        indegree[v]++;
    }

    queue<int> q;
    vector<long long> finish(n);

    // Initialize
    for (int i = 0; i < n; i++) {
        finish[i] = time[i];
        if (indegree[i] == 0)
            q.push(i);
    }

    // Topological order processing
    while (!q.empty()) {
        int u = q.front();
        q.pop();

        for (int v : adj[u]) {
            finish[v] = max(finish[v], finish[u] + time[v]);
            indegree[v]--;
            if (indegree[v] == 0)
                q.push(v);
        }
    }

    return *max_element(finish.begin(), finish.end());
}











