#include <bits/stdc++.h>
using namespace std;

bool dfs(int u, vector<vector<int>>& adj, vector<int>& color) {
    color[u] = 1; // gray (in progress)

    for (int v : adj[u]) {
        if (color[v] == 1) return true;        // back edge → cycle
        if (color[v] == 0 && dfs(v, adj, color)) 
            return true;
    }

    color[u] = 2; // black (finished)
    return false;
}

bool hasCycle(int n, vector<vector<int>>& adj) {
    vector<int> color(n, 0); // 0 = white

    for (int i = 0; i < n; i++) {
        if (color[i] == 0) {
            if (dfs(i, adj, color)) return true;
        }
    }
    return false;
}

int main() {
    int n, m;
    cin >> n >> m;

    vector<vector<int>> adj(n);
    for (int i = 0; i < m; i++) {
        int u, v;
        cin >> u >> v;
        adj[u].push_back(v);   // directed edge u → v
    }

    if (hasCycle(n, adj))
        cout << "Cycle exists\n";
    else
        cout << "No cycle\n";
}







