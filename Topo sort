#include <bits/stdc++.h>
using namespace std;

vector<vector<pair<int,int>>> adj;
vector<int> topo;
vector<bool> vis;

void dfs(int u) {
    vis[u] = true;
    for (auto [v, w] : adj[u])
        if (!vis[v])
            dfs(v);
    topo.push_back(u);
}

int main() {
    int n, m;
    cin >> n >> m;

    adj.assign(n, {});
    vis.assign(n, false);

    for (int i = 0; i < m; i++) {
        int u, v, w;
        cin >> u >> v >> w;
        adj[u].push_back({v, w});
    }

    // Topological sort
    for (int i = 0; i < n; i++)
        if (!vis[i])
            dfs(i);

    reverse(topo.begin(), topo.end());

    int src;
    cin >> src;

    const long long INF = 1e18;
    vector<long long> dist(n, INF);
    dist[src] = 0;

    // DP relaxation in topo order
    for (int u : topo) {
        if (dist[u] != INF) {
            for (auto [v, w] : adj[u]) {
                dist[v] = min(dist[v], dist[u] + w);
            }
        }
    }

    // Output
    for (int i = 0; i < n; i++) {
        if (dist[i] == INF)
            cout << "INF ";
        else
            cout << dist[i] << " ";
    }
}








Topological sort gives correct processing order in DAG;
DP relaxation in that order computes shortest paths in linear time.






