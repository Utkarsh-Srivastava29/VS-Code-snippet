#include <bits/stdc++.h>
using namespace std;

int main() {
    int n, m;
    cin >> n >> m;               // n nodes, m edges
    vector<vector<int>> adj(n);
    
    for(int i = 0; i < m; i++) {
        int u, v;
        cin >> u >> v;
        u--; v--;
        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    vector<int> color(n, -1);    // -1 = uncolored, 0/1 = colors
    bool ok = true;

    for(int i = 0; i < n; i++) {
        if(color[i] == -1) {
            queue<int> q;
            q.push(i);
            color[i] = 0;

            while(!q.empty()) {
                int v = q.front(); q.pop();
                for(int u : adj[v]) {
                    if(color[u] == -1) {
                        color[u] = color[v] ^ 1;
                        q.push(u);
                    } else if(color[u] == color[v]) {
                        ok = false;
                        break;
                    }
                }
                if(!ok) break;
            }
        }
        if(!ok) break;
    }

    if(!ok) {
        cout << "NOT BIPARTITE\n";
    } else {
        cout << "BIPARTITE\n";
        // print partitions
        for(int i = 0; i < n; i++)
            cout << color[i] << " ";
        cout << "\n";
    }
}







