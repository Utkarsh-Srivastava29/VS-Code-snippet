        g[a].push_back(b);
        g[b].push_back(a);
    }

    vector<int> color(n + 1, 0); // 0 = unvisited, 1 = team 1, 2 = team 2

    for (int i = 1; i <= n; i++) {
        if (color[i] != 0) continue;

        queue<int> q;
        q.push(i);
        color[i] = 1;

        while (!q.empty()) {
            int u = q.front();
            q.pop();

            for (int v : g[u]) {
                if (color[v] == 0) {
                    color[v] = 3 - color[u]; // flips 1 <-> 2
                    q.push(v);
