16.Only if all components pass is the graph bipartite. Forgetting this outer loop is one of the most common bugs.Disconnected Graphs considered.
17.
#include <bits/stdc++.h>
using namespace std;

vector<vector<int>> adj;
vector<int> color;   // -1 = uncolored, 0 / 1 = two colors
bool ok = true;

void dfs(int v, int c) {
    color[v] = c;
    for (int u : adj[v]) {
        if (color[u] == -1) {
            dfs(u, c ^ 1);   // opposite color
            if (!ok) return;
        }
        else if (color[u] == c) {
            ok = false;     // conflict
            return;
        }
    }
}

int main() {
    int n, m;
    cin >> n >> m;

    adj.assign(n, {});
    color.assign(n, -1);

    for (int i = 0; i < m; i++) {
        int u, v;
        cin >> u >> v;
        --u; --v;
        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    // Handle disconnected graph
    for (int i = 0; i < n; i++) {
        if (color[i] == -1) {
            dfs(i, 0);
            if (!ok) break;
        }
    }

    cout << (ok ? "YES\n" : "NO\n");
    return 0;
}





