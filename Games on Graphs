#include <bits/stdc++.h>
using namespace std;

int main() {
    int n, m;
    cin >> n >> m;

    vector<vector<int>> g(n);
    vector<int> indeg(n, 0);

    // Read edges
    for (int i = 0; i < m; i++) {
        int u, v;
        cin >> u >> v;
        g[u].push_back(v);
        indeg[v]++;
    }

    // Topological order
    queue<int> q;
    for (int i = 0; i < n; i++) {
        if (indeg[i] == 0) q.push(i);
    }

    vector<int> topo;
    while (!q.empty()) {
        int u = q.front(); q.pop();
        topo.push_back(u);
        for (int v : g[u]) {
            if (--indeg[v] == 0)
                q.push(v);
        }
    }

    // 0 = LOSE, 1 = WIN
    vector<int> state(n, 0);

    // Process in reverse topological order
    for (int i = n - 1; i >= 0; i--) {
        int u = topo[i];
        for (int v : g[u]) {
            if (state[v] == 0) {   // move to LOSE
                state[u] = 1;      // WIN
                break;
            }
        }
    }

    // Output result
    for (int i = 0; i < n; i++) {
        if (state[i]) cout << "WIN\n";
        else cout << "LOSE\n";
    }

    return 0;
}


 





