#include <bits/stdc++.h>          // Includes all standard C++ libraries
using namespace std;              // Allows use of std names directly

/*
 Game result states:
 DRAW       → game can continue forever
 MOUSE_WIN  → mouse can force a win
 CAT_WIN    → cat can force a win
*/
static const int DRAW = 0;        // State value for draw
static const int MOUSE_WIN = 1;   // State value when mouse wins
static const int CAT_WIN = 2;     // State value when cat wins

/*
 Turn indicator:
 MOUSE_TURN → mouse moves
 CAT_TURN   → cat moves
*/
static const int MOUSE_TURN = 0;  // Mouse's turn
static const int CAT_TURN = 1;    // Cat's turn

// Function that solves the Cat and Mouse game
int catMouseGame(vector<vector<int>>& graph) {

    int n = graph.size();         // Number of nodes in the graph

    // result[mouse][cat][turn] stores the outcome of that state
    vector<vector<vector<int>>> result(
        n, vector<vector<int>>(n, vector<int>(2, DRAW))
    );

    // degree[mouse][cat][turn] = number of legal moves remaining
    vector<vector<vector<int>>> degree(
        n, vector<vector<int>>(n, vector<int>(2, 0))
    );

    // Queue for reverse BFS (processing known states backward)
    queue<tuple<int,int,int>> q;

    // Initialize degree counts for every possible state
    for (int mouse = 0; mouse < n; mouse++) {
        for (int cat = 0; cat < n; cat++) {

            // Mouse can move to all neighbors of its current node
            degree[mouse][cat][MOUSE_TURN] = graph[mouse].size();

            // Cat can move to all neighbors of its current node
            degree[mouse][cat][CAT_TURN] = graph[cat].size();

            // Cat is not allowed to move to hole (node 0)
            for (int v : graph[cat]) {
                if (v == 0) {
                    degree[mouse][cat][CAT_TURN]--;  // Remove illegal move
                }
            }
        }
    }

    // Base Case 1: Mouse reaches the hole (node 0)
    for (int cat = 1; cat < n; cat++) {

        // Mouse wins no matter whose turn it is
        result[0][cat][MOUSE_TURN] = MOUSE_WIN;
        result[0][cat][CAT_TURN] = MOUSE_WIN;

        // Push these resolved states into the queue
        q.push({0, cat, MOUSE_TURN});
        q.push({0, cat, CAT_TURN});
    }

    // Base Case 2: Cat catches mouse (same node)
    for (int pos = 1; pos < n; pos++) {

        // Cat wins immediately
        result[pos][pos][MOUSE_TURN] = CAT_WIN;
        result[pos][pos][CAT_TURN] = CAT_WIN;

        // Push resolved states into the queue
        q.push({pos, pos, MOUSE_TURN});
        q.push({pos, pos, CAT_TURN});
    }

    // Reverse BFS to propagate results backward
    while (!q.empty()) {

        // Get the front state from the queue
        auto [mouse, cat, turn] = q.front();
        q.pop();

        // Current resolved result
        int curResult = result[mouse][cat][turn];

        // If current state was mouse's turn
        if (turn == MOUSE_TURN) {

            // Parent states must have been cat's turn
            for (int prevCat : graph[cat]) {

                // Cat cannot move into hole
                if (prevCat == 0) continue;

                // Skip if already decided
                if (result[mouse][prevCat][CAT_TURN] != DRAW) continue;

                // If cat can force a win, parent is CAT_WIN
                if (curResult == CAT_WIN) {
                    result[mouse][prevCat][CAT_TURN] = CAT_WIN;
                    q.push({mouse, prevCat, CAT_TURN});
                }
                // Otherwise reduce remaining legal moves
                else {
                    degree[mouse][prevCat][CAT_TURN]--;
                    // If no safe moves left, mouse wins
                    if (degree[mouse][prevCat][CAT_TURN] == 0) {
                        result[mouse][prevCat][CAT_TURN] = MOUSE_WIN;
                        q.push({mouse, prevCat, CAT_TURN});
                    }
                }
            }
        }
        // If current state was cat's turn
        else {

            // Parent states must have been mouse's turn
            for (int prevMouse : graph[mouse]) {

                // Skip if already decided
                if (result[prevMouse][cat][MOUSE_TURN] != DRAW) continue;

                // If mouse can force a win, parent is MOUSE_WIN
                if (curResult == MOUSE_WIN) {
                    result[prevMouse][cat][MOUSE_TURN] = MOUSE_WIN;
                    q.push({prevMouse, cat, MOUSE_TURN});
                }
                // Otherwise reduce remaining legal moves
                else {
                    degree[prevMouse][cat][MOUSE_TURN]--;
                    // If no safe moves left, cat wins
                    if (degree[prevMouse][cat][MOUSE_TURN] == 0) {
                        result[prevMouse][cat][MOUSE_TURN] = CAT_WIN;
                        q.push({prevMouse, cat, MOUSE_TURN});
                    }
                }
            }
        }
    }

    // Return result of initial state:
    // Mouse at node 1, Cat at node 2, Mouse moves first
    return result[1][2][MOUSE_TURN];
}

int main() {

    int n;                         // Number of nodes
    cin >> n;                      // Read number of nodes

    vector<vector<int>> graph(n);  // Adjacency list

    // Read graph
    for (int i = 0; i < n; i++) {
        int k;                     // Number of edges from node i
        cin >> k;
        graph[i].resize(k);
        for (int j = 0; j < k; j++) {
            cin >> graph[i][j];    // Read neighbor
        }
    }

    // Solve the game
    int ans = catMouseGame(graph);

    // Print result
    if (ans == MOUSE_WIN) cout << "Mouse Wins\n";
    else if (ans == CAT_WIN) cout << "Cat Wins\n";
    else cout << "Draw\n";

    return 0;                      // End of program
}














