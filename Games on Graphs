#include <bits/stdc++.h>
using namespace std;

vector<vector<int>> tree;   // adjacency list of tree
vector<int> score;          // score at leaf nodes
int n;

/*
 u       → current node
 parent → parent node (to avoid going back)
 isMax  → true if MAX player's turn, false if MIN player's turn
*/
int dfs_minimax(int u, int parent, bool isMax) {

    bool isLeaf = true;
    int best;

    if (isMax) best = INT_MIN;
    else best = INT_MAX;

    for (int v : tree[u]) {
        if (v == parent) continue;   // avoid going back
        isLeaf = false;

        int val = dfs_minimax(v, u, !isMax);

        if (isMax)
            best = max(best, val);
        else
            best = min(best, val);
    }

    // If leaf node → return its score
    if (isLeaf) return score[u];

    return best;
}

int main() {
    cin >> n;

    tree.resize(n);
    score.resize(n);

    // Read tree edges
    for (int i = 0; i < n - 1; i++) {
        int u, v;
        cin >> u >> v;
        tree[u].push_back(v);
        tree[v].push_back(u);
    }

    // Read score for each node
    // (Only leaf scores matter, but we read all)
    for (int i = 0; i < n; i++)
        cin >> score[i];

    // Start DFS minimax from root = 0, MAX starts
    int ans = dfs_minimax(0, -1, true);

    cout << ans << "\n";
}









